# Local Express server
PORT=5000

# MongoDB Atlas. Replace the placeholders in backend/.env only.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/garima?retryWrites=true&w=majority
MONGODB_DB_NAME=garima

# Comma-separated frontend origins allowed to call this API. Set the deployed Vercel origin on Render.
CORS_ORIGINS=https://your-garima-site.vercel.app

# Optional Razorpay test-mode credentials. Never use live keys here.
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
